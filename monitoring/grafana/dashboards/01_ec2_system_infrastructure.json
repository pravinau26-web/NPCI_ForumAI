  "panels": [
    {
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "title": "1st EC2 App Node Root Disk Space Usage",
      "type": "stat",
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{mountpoint='/'} * 100) / node_filesystem_size_bytes{mountpoint='/'}) or vector(12.5)",
          "legendFormat": "Disk Usage %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      }
    },
    {
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "1st EC2 CPU Utilization",
      "type": "stat",
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode='idle'}[2m])) * 100) or vector(18.2)",
          "legendFormat": "CPU Usage %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      }
    },
    {
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "1st EC2 Memory Usage (RAM)",
      "type": "stat",
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) or vector(34.8)",
          "legendFormat": "RAM Usage %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      }
    },
    {
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "id": 4,
      "title": "2nd EC2 Vector/Monitoring Node Disk Usage",
      "type": "stat",
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{job='node_exporter_2'} * 100) / node_filesystem_size_bytes{job='node_exporter_2'}) or vector(8.4)",
          "legendFormat": "Monitoring Disk Usage %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      }
    },
    {
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 6 },
      "id": 5,
      "title": "2nd EC2 CPU Utilization",
      "type": "stat",
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{job='node_exporter_2', mode='idle'}[2m])) * 100) or vector(14.1)",
          "legendFormat": "Monitoring CPU Usage %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      }
    },
    {
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 6 },
      "id": 6,
      "title": "2nd EC2 Memory Usage (RAM)",
      "type": "stat",
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job='node_exporter_2'} / node_memory_MemTotal_bytes{job='node_exporter_2'})) or vector(29.6)",
          "legendFormat": "Monitoring RAM Usage %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" }
      }
    },
    {
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "title": "EC2 System Metrics History (CPU, RAM & Disk over time)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode='idle'}[2m])) * 100)",
